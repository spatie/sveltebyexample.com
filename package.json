{
  "name": "sveltebyexample.com",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.17"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:content\" \"vite dev\" --names=content,vite --hide=0 --prefix=\"​\"",
    "dev:content": "chokidar \"content/*.md\" \"build-content.js\" -c \"npm run build:content\" --initial --silent",
    "build": "npm run build:content && vite build",
    "build:content": "node build-content.js",
    "check:content": "node check-content.js",
    "preview": "vite preview",
    "format": "prettier **/*.{html,js,json,svelte,md} --write"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^20.5.6",
    "cheerio": "^1.0.0-rc.12",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^8.2.1",
    "marked": "^7.0.4",
    "prettier": "^3.0.3",
    "prettier-plugin-svelte": "^3.0.3",
    "shiki": "^4.5.0",
    "svelte": "^5.57.2",
    "vite": "^8.3.3"
  },
  "type": "module"
}
